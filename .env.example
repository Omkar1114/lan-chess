# LAN Chess configuration.
# Copy this file to ".env" and adjust it. NEVER commit the real .env file.

# --- Network -----------------------------------------------------------------
# Port published on the server machine (Docker). Players open http://<server-ip>:<HOST_PORT>
HOST_PORT=8080
# Interface the port is bound to. 0.0.0.0 = all interfaces (needed for LAN access).
HOST_BIND=0.0.0.0
# Only used when running WITHOUT Docker (scripts/start.sh): listen address and port.
APP_HOST=0.0.0.0
APP_PORT=8080

# --- Security ----------------------------------------------------------------
# Secret used to protect session tokens. Leave the placeholder to have a random
# key generated on first start and stored in the data volume, or set your own:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Administrator account, created/updated at start-up. The admin can delete saved
# games and abort running ones. Leave the placeholder password to create no admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Set to false once everyone has an account to stop new sign-ups.
ALLOW_REGISTRATION=true
# Days a login stays valid.
SESSION_DAYS=30

# --- Appearance --------------------------------------------------------------
# Shown in the page title and in the "Site" tag of exported PGN files.
SITE_NAME=LAN Chess

# --- Engine (Stockfish) ------------------------------------------------------
# Path of the Stockfish binary. Leave empty: Docker sets it, and outside Docker
# it is looked up on the PATH.
STOCKFISH_PATH=
# CPU threads and hash table size (MB) per engine process.
ENGINE_THREADS=1
ENGINE_HASH_MB=32
# How many analysis boards may run an engine at the same time.
MAX_ANALYSIS_ENGINES=2

# --- Misc --------------------------------------------------------------------
# Only used without Docker: where the database is stored (default: ./data).
# DATA_DIR=./data
# debug | info | warning | error
LOG_LEVEL=info
